<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tv_add_feeling_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Add New Feeling"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily="@font/nunitosemibold" />
    </LinearLayout>

    <!-- Input Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_feeling_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/edit_text_feeling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_background2"
                android:hint="Enter feeling name"
                android:padding="12dp"
                android:textSize="16sp"
                android:fontFamily="@font/nunitosemibold"
                android:inputType="textCapWords" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Save Button -->
    <Button
        android:id="@+id/btn_save_feeling"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Save Feeling"
        android:textColor="@android:color/white"
        android:elevation="4dp"
        android:background="@drawable/bg_btn"
        android:padding="8dp"
        android:textAllCaps="false"
        android:fontFamily="@font/nunitosemibold"
        app:layout_constraintTop_toBottomOf="@+id/cv_feeling_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>