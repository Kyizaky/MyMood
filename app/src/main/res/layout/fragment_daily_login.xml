<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#D2DBE6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

    <ImageView
        android:id="@+id/btn_back"
        android:src="@drawable/ic_back"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tv_streak_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:textColor="@color/black"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:fontFamily="@font/nunitosemibold" />

        <TextView
            android:id="@+id/tv_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="305"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:textColor="#1E293B"
            android:layout_marginTop="17dp"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunitobold" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/prevPet"
            android:src="@drawable/chevron_left"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/circular_ripple"
            android:visibility="gone"
            android:layout_marginStart="20dp"/>

        <ImageView
            android:id="@+id/pet_image"
            android:src="@drawable/pet3"
            android:layout_width="210dp"
            android:background="@drawable/circular_ripple"
            android:padding="10dp"
            android:layout_height="210dp"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/nextPet"
            android:src="@drawable/ic_chevron_right"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circular_ripple"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ikky"
        android:fontFamily="@font/nunitosemibold"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"/>
    <Button
        android:id="@+id/btn_evolve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/nunitoregular"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn"
        android:text="Evolve"
        android:visibility="gone"
        />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pet_progress"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="50dp"
        android:max="100"
        app:indicatorColor="#6B4EFF"
        app:trackColor="#E2E8F0"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_evolve" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_points"
        android:text="28 poin untuk membuka tampilan berikutnya"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosemibold"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="7dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raise Your Pet"
                android:textSize="18sp"
                android:fontFamily="@font/nunitoregular"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>


            <!-- Item checklist -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <ImageView
                    android:id="@+id/check1"
                    android:src="@drawable/ic_checkbox"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login to the App"
                    android:textColor="@color/black"
                    android:fontFamily="@font/nunitoregular"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <ImageView
                    android:id="@+id/check2"
                    android:src="@drawable/ic_checkbox"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Log mood once"
                    android:textColor="@color/black"
                    android:fontFamily="@font/nunitoregular"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_claimPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="90dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/nunitobold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:background="@drawable/bg_btn_disabled"
                android:text="Claim"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    </LinearLayout>
