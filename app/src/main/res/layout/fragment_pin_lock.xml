<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#e6edf6"
    android:padding="0dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="15dp"
        android:elevation="2dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside" />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <!-- Checkmark Button -->
        <ImageButton
            android:id="@+id/btnOk"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_checkmark"
            android:background="@drawable/btn_checkmark_bg"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter PIN"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/nunitobold"
                android:textColor="#333333"
                android:layout_marginBottom="32dp" />

            <!-- PIN Dots Display -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="48dp"
                android:spacing="16dp">

                <View
                    android:id="@+id/pin_dot_1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_marginEnd="12dp" />

                <View
                    android:id="@+id/pin_dot_2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_marginEnd="12dp" />

                <View
                    android:id="@+id/pin_dot_3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/pin_dot_empty"
                    android:layout_marginEnd="12dp" />

                <View
                    android:id="@+id/pin_dot_4"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/pin_dot_empty" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Keypad Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#e6edf6"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="100dp">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="2"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="4"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="5"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_6"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="6"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_7"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="7"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_8"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="8"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btn_9"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="9"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

        </LinearLayout>

        <!-- Row 4: 0, Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5B9BD5"
                android:background="@color/transparent"
                android:elevation="0dp" />

            <ImageButton
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_backspace_gray"
                android:background="@color/transparent"
                android:scaleType="centerInside" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>